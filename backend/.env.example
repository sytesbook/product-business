# Docker Compose Environment Variables
# These variables are used by Docker Compose for interpolation in docker-compose.yml
# Copy this file to .env and update with your actual values
# Note: .env is gitignored and should never be committed

# Domain configuration (used for production URLs)
DOMAIN=localhost

# MySQL root password
MYSQL_ROOT_PASSWORD=root_db_password_local

# wp-home-site database configuration
WP_HOME_DB_NAME=wp_home_site_db
WP_HOME_DB_USER=wp_home_db_user
WP_HOME_DB_PASSWORD=local_db_password
WP_HOME_ENV=development

# wp-home-site WordPress security keys
# NOTE: Use only alphanumeric characters [0-9a-zA-Z] to avoid Docker Compose variable interpolation issues
# Generate random 64-char strings or use https://roots.io/salts.html (then remove special chars)
WP_HOME_AUTH_KEY="local-dev-auth-key-change-me"
WP_HOME_SECURE_AUTH_KEY="local-dev-secure-auth-key-change-me"
WP_HOME_LOGGED_IN_KEY="local-dev-logged-in-key-change-me"
WP_HOME_NONCE_KEY="local-dev-nonce-key-change-me"
WP_HOME_AUTH_SALT="local-dev-auth-salt-change-me"
WP_HOME_SECURE_AUTH_SALT="local-dev-secure-auth-salt-change-me"
WP_HOME_LOGGED_IN_SALT="local-dev-logged-in-salt-change-me"
WP_HOME_NONCE_SALT="local-dev-nonce-salt-change-me"

# wp-home-site WordPress auto-installation
WP_HOME_ADMIN_USER=admin
WP_HOME_ADMIN_PASSWORD=local_wp_password
WP_HOME_ADMIN_EMAIL=admin@example.com
WP_HOME_SITE_TITLE="Home Site"

# wp-customer-sites database configuration
WP_CUSTOMERS_DB_NAME=wp_customer_sites_db
WP_CUSTOMERS_DB_USER=wp_customers_db_user
WP_CUSTOMERS_DB_PASSWORD=local_db_password
WP_CUSTOMERS_ENV=development

# wp-customer-sites WordPress security keys
# NOTE: Use only alphanumeric characters [0-9a-zA-Z] to avoid Docker Compose variable interpolation issues
# Generate random 64-char strings or use https://roots.io/salts.html (then remove special chars)
WP_CUSTOMERS_AUTH_KEY="local-dev-auth-key-change-me"
WP_CUSTOMERS_SECURE_AUTH_KEY="local-dev-secure-auth-key-change-me"
WP_CUSTOMERS_LOGGED_IN_KEY="local-dev-logged-in-key-change-me"
WP_CUSTOMERS_NONCE_KEY="local-dev-nonce-key-change-me"
WP_CUSTOMERS_AUTH_SALT="local-dev-auth-salt-change-me"
WP_CUSTOMERS_SECURE_AUTH_SALT="local-dev-secure-auth-salt-change-me"
WP_CUSTOMERS_LOGGED_IN_SALT="local-dev-logged-in-salt-change-me"
WP_CUSTOMERS_NONCE_SALT="local-dev-nonce-salt-change-me"

# wp-customer-sites WordPress auto-installation
WP_CUSTOMERS_ADMIN_USER=admin
WP_CUSTOMERS_ADMIN_PASSWORD=local_wp_password
WP_CUSTOMERS_ADMIN_EMAIL=admin@customers.example.com
WP_CUSTOMERS_SITE_TITLE="Customer Sites"

# SNS configuration
# AWS region for SNS (used in both local and production)
AWS_DEFAULT_REGION=us-east-1

# SNS topic ARN for backend events
# Production: set to the real AWS SNS topic ARN (e.g. arn:aws:sns:us-east-1:123456789012:backend-events)
# Local: leave empty — docker-compose.override.yml supplies the LocalStack ARN automatically
SNS_TOPIC_ARN=
